extends layout.pug

block head
    link(rel="stylesheet" href=`/stylesheets/balance-checker.css?v=${assetVersion}`)
    script(src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js")

    each file in ["globals", "constants", "utility", "modal", "search", "events", "error-validation", "frontend", "tabs", "resources", "main"]
        script(src=`/scripts/checker/checker-${file}.js?v=${assetVersion}` type="text/javascript" defer="defer")

block header
    button#settings-button.tool.framed(type="button" title="Checker settings" aria-label="Checker settings")
        img(src="/iconography/Settings.webp" alt="")
    div.ctx
        button#balancing-select-button.pick.t(type="button")
            img(src="/iconography/ui/trophy.webp" alt="")
            span.txt
                span.l Tournament
                span#selected-balance-title.v
            span.caret ▼
        button#killer-select-button.pick.k(type="button")
            img#selected-killer-portrait(alt="")
            span.txt
                span#selected-killer-label.l Killer
                span#selected-killer-title.v
            span.caret ▼

block content
    div.subbar.gutter
        div.col
            div.rolestep(role="group" aria-label="Check as")
                div.in
                    button#role-killer-button(type="button" data-role="1" aria-pressed="false")
                        img(src="/iconography/Killer.webp" alt="")
                        span.rl Killer
                    button#role-survivor-button(type="button" data-role="0" aria-pressed="true")
                        img(src="/iconography/Survivor.webp" alt="")
                        span.rl Survivors
            div.tabrow
                nav#checker-tabs.tabs(role="tablist")
                    button(type="button" role="tab" data-tab="loadout" aria-selected="true")
                        | Loadout
                        img#loadout-tab-mark.bang(src="/iconography/ui/bang.webp" alt="" hidden)
                    button(type="button" role="tab" data-tab="rules" aria-selected="false")
                        | Notes &amp; Maps
                        img#rules-tab-mark.bang(src="/iconography/ui/bang.webp" alt="" hidden)
                    button(type="button" role="tab" data-tab="bans" aria-selected="false")
                        | Bans
                        sup#bans-tab-count

    div.gutter
        main#main-balance-window.col
            section#loadout-panel(data-panel="loadout")
                h2.stitle
                    span#selected-role-header Survivor Builds
                    small#selected-role-subtitle
                div#survivor-builds-container
                    each survivor in [1, 2, 3, 4]
                        div.build
                            div.who Survivor #{survivor}
                            div.survivor-build-component.slots
                div#killer-builds-container(class="hide-component")
                    div.build
                        div#killer-build-name.who Killer
                        div#killer-build-component.slots
                div#import-export-button-container.actions
                    button#import-button.btn(type="button") Import Image
                    button#export-button.btn(type="button") Export Loadout
                    button#generate-image-button.btn(type="button") Generate Image
                    button#clear-loadout-button.btn.danger(type="button") Clear Loadout
            section#rules-panel(data-panel="rules" hidden)
            section#bans-panel(data-panel="bans" hidden)
                div.bansearch
                    input#bans-search-input(type="search" placeholder="Search perks, items, add-ons, offerings" autocomplete="off")
                div#bans-list
            div#loadout-side.side
                aside#errors-window.errors.clean
                    h2#error-panel-title.err-title No Errors
                    ul#error-list-container.errlist
                section#match-rules.matchcard
                section#killer-maps.matchcard

    //- Killer selection
    div#balance-character-select-container.scrim(hidden)
        div.dlg(role="dialog" aria-modal="true" aria-label="Choose a killer")
            div.dlg-head
                h2 Choose a killer
                button.dlg-x(type="button" data-close aria-label="Close") ✕
            div.dlg-search
                input#killer-search-input(type="search" placeholder="Search killers" autocomplete="off")
                label
                    input#hide-disabled-killers(type="checkbox")
                    | Hide disabled killers
            div.dlg-body
                div#character-select-grid.kgrid

    //- Tournament (balancing) selection
    div#balancing-select-container.scrim(hidden)
        div#balancing-select-menu.dlg(role="dialog" aria-modal="true" aria-label="Tournament")
            div.dlg-head
                h2#balancing-select-title Tournament
                button#balancing-select-close-button.dlg-x(type="button" data-close aria-label="Close") ✕
            div.dlg-tabs(role="tablist")
                button(type="button" role="tab" data-balancing-tab="choose" aria-selected="true") Choose
                button(type="button" role="tab" data-balancing-tab="custom" aria-selected="false") Custom balancing
            div#balancing-choose-tab
                div.dlg-search
                    input#balancing-select-search-input(type="search" placeholder="Search for Balancing Presets..." autocomplete="off")
                div.dlg-body
                    div#balancing-select-options-container.opts
            div#balancing-custom-tab.dlg-body.upload(hidden)
                p#balancing-select-subtitle Paste a balancing exported from Create. It is saved in this browser.
                textarea#custom-balance-select(placeholder="Enter Custom Balance JSON..." spellcheck="false")
                p#custom-error.msg.bad(hidden)
                div.row
                    button#custom-balance-save-button.btn.primary(type="button") Save &amp; Use

    //- Perk, offering, item and add-on search
    div#perk-search-container.scrim(hidden)
        div#perk-search-module-container.dlg(role="dialog" aria-modal="true")
            div.dlg-head
                h2#perk-search-title Choose a perk
                button.dlg-x(type="button" data-close aria-label="Close") ✕
            div.dlg-search
                input#perk-search-bar(type="search" placeholder="Search Perks..." autocomplete="off")
                label
                    input#only-non-banned-search(type="checkbox")
                    | Only show allowed
            div.dlg-body
                p#perk-highlight-name.muted Select a Perk...
                div#perk-search-results-module.pgrid

    //- Settings
    div#settings-container.scrim(hidden)
        div#settings-menu.dlg.narrow(role="dialog" aria-modal="true" aria-label="Checker settings")
            div.dlg-head
                h2 Checker settings
                button#settings-cancel-button.dlg-x(type="button" data-close aria-label="Close") ✕
            div.dlg-body.settings
                h3 Picking
                label.setting
                    input#only-non-banned(type="checkbox")
                    span Only show allowed Perks/Offerings/Items
                        small Hide banned perks, offerings and items in search. You can still flip it per search.
                label.setting
                    input#hide-disabled-killers-setting(type="checkbox")
                    span Hide disabled killers
                        small Leave killers this tournament doesn't allow out of the killer list.
                h3 Notes
                label.setting
                    input#auto-show-notes(type="checkbox")
                    span Mark new notes
                        small Show ! on the Notes &amp; Maps tab when the tournament or killer has notes you haven't opened yet.
                h3 On this device
                span#save-loadouts-killer-container(hidden)
                    label.setting
                        input#save-loadouts-killer(type="checkbox")
                        span Auto-save Loadouts &amp; Killer selected
                            small Saved in this browser only. Links always carry their own loadout.
                label.setting
                    input#import-killer-choice-input(type="checkbox")
                    span Import Killer selection during image import
                        small Uses the killer detected in the imported image.
                div#settings-clear-confirm.confirm
                    button#settings-clear-storage-button.btn.danger(type="button") Clear Settings

    //- Generated image
    div#image-gen-container.scrim(hidden)
        div#image-gen-menu.dlg(role="dialog" aria-modal="true")
            div.dlg-head
                h2#image-gen-title Generating Image...
            div.dlg-body
                p#image-gen-message
                img#image-gen-image.genimg(hidden alt="Generated loadout image")
                div#image-gen-button-container.dlg-actions
                    button#image-gen-ok-button.btn.primary(type="button") OK

    //- Image import
    div#modal-import-container.scrim(hidden)
        div#modal-import-content.dlg.narrow(role="dialog" aria-modal="true" aria-label="Import Image")
            div.dlg-head
                h2#modal-import-title Import Image
                button.dlg-x(type="button" data-close aria-label="Close") ✕
            div.dlg-body
                div#modal-import-drop-zone.dropzone
                    span
                        | Click here
                        br
                        | or
                        br
                        | Drag &amp; Drop an image
                div#modal-import-button.dlg-actions
                    input#import-image(type="file" name="image" accept="image/*" hidden)
                    button#modal-import-cancel-button.btn(type="button") Cancel

    //- Alerts
    div#alert-container.scrim(hidden)
        div#alert-menu.dlg.narrow(role="dialog" aria-modal="true")
            div.dlg-head
                h2#alert-title
            div.dlg-body
                div#alert-message.alert-body
                div#alert-button-container.dlg-actions
                    button#alert-ok-button.btn.primary(type="button") OK

block scripts
    script.
        window.addEventListener("load", () => BeginResourceChain());
